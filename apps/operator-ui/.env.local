GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_LOCATION_PICKER_MAP_ID=YOUR_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_ADDRESS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
HASURA_ADMIN_SECRET=CitrineOS!
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LATITUDE=39.833333 # The visual center of the contiguous USA.
NEXT_PUBLIC_DEFAULT_MAP_CENTER_LONGITUDE=-98.583333 # The visual center of the contiguous USA.
NEXT_PUBLIC_API_URL=http://localhost:8090/v1/graphql
NEXT_PUBLIC_WS_URL=ws://localhost:8090/v1/graphql
NEXT_PUBLIC_CITRINE_CORE_URL=http://localhost:8080
NEXT_PUBLIC_FILE_SERVER_URL=http://localhost:8050
NEXT_PUBLIC_LOGO_URL=https://d1h8867rcwtfcw.cloudfront.net/logo-collapsed.svg
NEXT_PUBLIC_ADMIN_EMAIL=admin@citrineos.com
ADMIN_PASSWORD=CitrineOS!
NEXT_PUBLIC_BANNER_MESSAGE=
# Must be the externally-reachable URL+port (3010, not the container's
# internal 3000) — NextAuth uses it to build the OAuth redirect_uri it sends
# to Keycloak. Gets sed'd to the real server IP alongside the other
# NEXT_PUBLIC_* URLs below on every redeploy.
NEXTAUTH_URL=http://localhost:3010
# Generate a real value at deploy time (e.g. `openssl rand -base64 24`).
NEXTAUTH_SECRET=REPLACE_WITH_GENERATED_SECRET

# Switches the login flow from the single hardcoded admin/password pair above
# to real Keycloak accounts (realm/client/users seeded from
# apps/ocpp-server/keycloak/citrineos-realm.json). See docker-compose.override.yml's
# `keycloak` service for the matching server-side config.
NEXT_PUBLIC_AUTH_PROVIDER=keycloak
# Browser-facing URL — must match the keycloak service's KC_HOSTNAME exactly
# (both say "localhost" here and get sed'd to the real server IP together).
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8180
# Server-to-server URL used by the Next.js API route inside the citrine-ui
# container — the Docker service DNS name, stable across redeploys, never
# needs sed'ing.
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=citrineos
KEYCLOAK_CLIENT_ID=citrineos-ui
# Must match the "secret" in apps/ocpp-server/keycloak/citrineos-realm.json exactly.
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_GENERATED_CLIENT_SECRET
ALLOW_IMAGE_UPLOAD=false